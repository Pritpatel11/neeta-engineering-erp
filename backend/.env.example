PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/neeta-engineering-erp
BACKUP_PATH=./backups
GROQ_API_KEY=your_groq_api_key_here
SANDBOX_API_KEY=your_sandbox_api_key_here
SANDBOX_API_SECRET=your_sandbox_api_secret_here
SANDBOX_BASE_URL=https://api.sandbox.co.in

# --- Email (Gmail SMTP) Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Neeta Engineering Works <your_email@gmail.com>"

# --- Model Context Protocol (MCP) Integration Key ---
ERP_MCP_API_KEY=your_mcp_secure_key_here
